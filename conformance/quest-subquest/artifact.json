            },
            "r": {
              "string": "failed"
            }
          }
        }
      },
      "objectives": [
        {
          "id": "delegate",
          "title": "Get the key",
          "titleLineId": "parentQ.delegate",
          "done": {
            "cel": "quest.findKey.state == 'complete'",
            "expr": {
              "op": "==",
              "l": {
                "path": "quest.findKey.state"
              },
              "r": {
                "string": "complete"
              }
            }
          },
          "optional": false,
          "body": null,
          "quest": "findKey"
        }
      ],
