---
kind: quest
id: quests.bonds
title: Bonds at the Hearth
---

<quest id="coldForge" title="The cold forge">
  <reward kind="KEEPSAKE" amount="1" target="oskarHammer"/>
  <objective id="hammerhead" title="Take the maul-head off the Gatekeeper" on="bossDefeated" target="boss.gatekeeper" done="holds('slew', ['gatekeeper'])">
    @narrator{code="0010"}: The maul-head is too heavy to carry and she carries it anyway.
  </objective>
  <objective id="reforge" title="Let Oskar reforge it" done="user.hammerReforged"/>
  <on event="questComplete">
    ::set{user.bond.oskar += 1}
    @oskar{code="0010"}: The forge is warm. First time in forty years. Don't tell Maud I cried.
  </on>
</quest>

<quest id="hammerTrial" title="Carry Oskar's hammer to the top" tier="run" start="holds('wields', ['hammer'])">
  <reward kind="EMBERS" amount="20"/>
  <objective id="top" title="Reach the Warden's floor before you fall" done="run.floor >= 9" by="@fellThisClimb"/>
  <on event="questComplete">
    @oskar{code="0020" os}: ...Heard that. All the way down here, I heard that.
  </on>
  <on event="questFailed">
    @narrator{code="0020"}: Far below, an anvil rings once, and stops.
  </on>
</quest>

<quest id="sableLost" title="What Sable lost" start="user.knowsSableName">
  <reward kind="KEEPSAKE" amount="1" target="greyFeather"/>
  <objective id="witness" title="Let Sable see the Warden fall" done="holds('saw', ['sable', 'wardenFall'])"/>
  <objective id="confide" title="Earn Sable's confidence" done="holds('confides', ['sable'])"/>
  <objective id="carry" title="Carry her feather out under the sky" on="runEnd" done="run.carriesFeather && @escapedThisClimb"/>
  <on event="questComplete">
    ::assert{saw(sable, featherOut)}
    ::set{user.bond.sable += 2}
    @sable{code="0010"}: I felt the wind. Through the feather. Forty years and I felt the wind.
  </on>
</quest>
