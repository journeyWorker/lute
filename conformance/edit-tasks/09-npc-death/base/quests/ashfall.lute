---
kind: quest
id: quests.ashfall
title: The Ashfall
---

<quest id="lilies" title="Three ash-lilies for Maud's kettle" tier="season:ashfall" start="user.ashfallOn" fail="!user.ashfallOn">
  <reward kind="EMBERS" amount="15"/>
  <objective id="three" title="Carry three ash-lilies down the Stair" done="season.ashfall.lilies >= 3"/>
  <on event="questComplete">
    ::set{user.bond.maud += 1}
    @maud{code="0010" emotion="fond"}: Three. You counted. Nobody counts for me.
  </on>
  <on event="questFailed">
    @narrator{code="0010"}: The last of the ash settles, and the lilies on the landings go back to being stone.
  </on>
</quest>
