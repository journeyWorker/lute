---
kind: quest
id: quests.festival
title: The Lantern Festival
---

// Accepted in days.arrival, whichever way the player answers Ines.
<quest id="forecast" title="A forecast for the festival" tier="run">
  <objective id="write" title="Write the forecast with Ines" done="run.forecastWritten"/>
  <objective id="deliver" title="Bring it down to Maren by Friday" done="run.forecastDelivered" by="run.day >= 6"/>
  <reward kind="KEEPSAKE" amount="1"/>
  <on event="questComplete">
    @narrator: Down in the village, Maren pins your forecast to the notice board with four drawing pins, one per corner, as if it might blow away.
  </on>
  <on event="questFailed">
    @narrator: Friday comes and goes. Somewhere below, the village decides about Sunday without you.
  </on>
</quest>

// Accepted in wren.first. The lantern must be finished before the festival.
<quest id="lantern" title="Wren's lantern" tier="run">
  <objective id="paper" title="Find paper that won't tear in the wind" done="holds('carrying', ['paper'])"/>
  <objective id="wire" title="Beg some wire off the radio room" done="holds('carrying', ['wire'])"/>
  <objective id="candle" title="Find a candle that burns slow" done="holds('carrying', ['candle'])"/>
  <objective id="build" title="Build it with Wren before Sunday" on="visit" target="place.village" done="count('carrying', ['_']) >= 3" by="run.day >= 7"/>
  <reward kind="KEEPSAKE" amount="1"/>
  <on event="questComplete">
    @narrator: The lantern stands on Wren's windowsill, ribbed with radio wire, waiting for Sunday.
  </on>
  <on event="questFailed">
    @narrator: Wren's lantern frame hangs in her window, unpapered, like a birdcage with the bird gone.
  </on>
</quest>
