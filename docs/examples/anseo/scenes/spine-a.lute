    ::camera{shake="0.6" duration="0.5" at="0.35"}
  </track>
  <track subject="vesna" property="pos">
    ::auto{character="vesna" anchor="port" action="brace" at="0.4"}
  </track>
  <track subject="vesna" property="grip">
    ::auto{character="vesna" action="seal" at="0.9"}
  </track>
  <track channel="vfx">
