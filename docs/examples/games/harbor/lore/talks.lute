---
kind: lore
id: talks
components: [../components/villager-chat.component.lute]
---

<beat use="villagerChat" id="maraOne" who="mara" instance="use-001">
  @mara{code="0010"}: The sea was kinder when I was young.
</beat>

<beat use="villagerChat" id="maraTwo" who="mara" need="1" prev="talks.maraOne" instance="use-002">
  @mara{code="0010"}: You helped with the lanterns. Thank you.
</beat>

<beat use="villagerChat" id="tomasOne" who="tomas" instance="use-003"/>

<beat id="anyNod" on="talk" target="kind:villager" once="false" priority="-5">
  @narrator{code="0010"}: {{occasion.target:start}} nods at you.
</beat>

<beat id="landedFish" on="landed" target="kind:fish" once="false" when="occasion.payload.weight >= 1">
  @narrator{code="0010"}: You land a {{occasion.payload.weight}}-kilo {{occasion.target}}.
  <match subject="occasion.target">
    <when is="cod">
      ::haul{fish="cod"}
    </when>
    <when is="eel">
      ::haul{fish="eel"}
    </when>
    <when is="marlin">
      ::haul{fish="marlin"}
    </when>
  </match>
</beat>

<entry id="tideBark" on="tide" once="day" when="run.slot == 'dawn'">
  @narrator{code="0010"}: The tide turns at dawn.
</entry>

<beat id="launchGull" on="launch" target="boat.gull" once="run" spentBy="holds('caught', ['marlin'])">
  @harbormaster{code="0010"}: The Gull is yours for the day. Bring back a marlin.
</beat>

<beat id="lanternWish" on="lanternNight" title="Make a wish" once="season:lanterns">
  @narrator{code="0010"}: You send a paper lantern up and wish on Mara's nets.
  ::set{season.lanterns.wishes += 1}
  ::assert{wishedOn(mara)}
</beat>

<beat id="lanternWatch" on="lanternNight" title="Just watch" once="false">
  @narrator{code="0010"}: The sky fills with small lights.
  @mara{code="0010" when="holds('wishedOn', ['mara'])"}: I saw your lantern. Thank you.
</beat>
