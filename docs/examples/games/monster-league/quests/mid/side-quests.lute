---
kind: quest
id: mid.quests
title: Midlands side quests
---

// OWNED BY mid. Every quest is tier="run" (FINDINGS-lead F10).

// ── The Monster Center board: the Mill Road Riders (accept="external") ────
// The engine's Center board accepts it; Night Watchman Elbert on Route 10
// points players at the notice.
<quest id="midNightPatrol" title="Board: the Mill Road Riders" accept="external">
  <objective id="grit" title="Beat Biker Grit on Route 10, at night" done="holds(defeated(r10BikerGrit))"/>
  <objective id="vanya" title="Beat Biker Vanya on Route 10, at night" done="holds(defeated(r10BikerVanya))"/>
  <objective id="jolene" title="Beat Rocker Jolene, who leads the singing" done="holds(defeated(r10RockerJolene))"/>
  <reward kind="MONEY" amount="3000"/>
  <on event="questComplete">
    @r10Watchman{vo}: The Riders are asleep by ten now. The board says the bounty's yours. Enjoy the quiet, I know I will.
  </on>
</quest>

// ── The sleeping giant (complete="any") ───────────────────────────────────
// Accepted when the flute wakes Slumbear on Route 12 (mid.giantWakes). Catch
// it, or let it go: the battle ends with Slumbear seen but not caught.
<quest id="midSleepingGiant" title="The sleeping giant" complete="any">
  <objective id="caught" title="Catch Slumbear" done="holds(caught(slumbear))"/>
  <objective id="letGo" title="Let Slumbear go back to the hills" on="battleEnd" done="holds(seen(slumbear)) && !holds(caught(slumbear))"/>
  <on event="questComplete">
    @narrator{when="holds(caught(slumbear))"}: The ball rocks once, twice, three times, and Lake Hush goes quiet. The giant that slept across Route 12 for a hundred years is yours now.
    @narrator{when="!holds(caught(slumbear))"}: Slumbear shakes itself, yawns so wide the reeds flatten, and lumbers off toward the hills. The road to the sea gate is open.
  </on>
</quest>

// ── Madame Oriel's ghost stories (children taken up one by one) ───────────
// Madame Oriel (Silvercrest) tells three stories; each story accepts its
// child. The Spectral Lens shows the ghost at the haunt (midGhostSeen).
<quest id="midGhostStories" title="Madame Oriel's ghost stories">
  <objective id="theater" title="The theater ghost" quest="midGhostTheater"/>
  <objective id="well" title="The well ghost" quest="midGhostWell"/>
  <objective id="lighthouse" title="The lighthouse ghost" quest="midGhostLighthouse"/>
  <reward kind="TM" amount="1" target="shadowBall"/>
  <on event="questComplete">
    @silvercrestMedium{vo}: Three stories, three ghosts, all true. I knew it. I always knew it. Come and collect your reward, dear, before I start a fourth.
  </on>
</quest>

<quest id="midGhostTheater" title="The theater ghost" activate="accept">
  <objective id="see" title="Look through the Spectral Lens in the old Silvercrest theater" done="holds(midGhostSeen(silvercrestTheater))"/>
</quest>

<quest id="midGhostWell" title="The well ghost" activate="accept">
  <objective id="see" title="Look through the Spectral Lens down the Wardenmere well" done="holds(midGhostSeen(wardenmereWell))"/>
</quest>

<quest id="midGhostLighthouse" title="The lighthouse ghost" activate="accept">
  <objective id="see" title="Look through the Spectral Lens at the top of the Fairhaven lighthouse" done="holds(midGhostSeen(fairhavenLighthouse))"/>
</quest>

// ── The day care's runaway ────────────────────────────────────────────────
// Grandpa Tobbe (Fairhaven) asks; the Mothfuzz goes back to Grandma Ilse.
<quest id="midDayCareRunaway" title="The day care's runaway">
  <objective id="catch" title="Catch a Mothfuzz in the Wildmoor Preserve" done="holds(caught(mothfuzz))"/>
  <objective id="theReturn" title="Show it to Grandma Ilse at the day care" on="talk" target="npc.fairhavenDayCareLady" done="holds(caught(mothfuzz))"/>
  <reward kind="ITEM" amount="1" target="luckyEgg"/>
  <on event="questComplete">
    @fairhavenDayCareLady{vo}: That's not our Mothfuzz, dear. Ours came home on its own last night. But yours is lovely too. Keep it, and take this for your trouble.
  </on>
</quest>

// ── The contest champion ──────────────────────────────────────────────────
// Opens when the player first talks to the contest desk.
<quest id="midContestChampion" title="Wildmoor's best bug catcher" start="visited('mid.bugContest.register')">
  <objective id="win" title="Win first prize at the bug-catching contest" done="run.midContestWins >= 1"/>
  <objective id="three" title="Win three first prizes" done="run.midContestWins >= 3" optional/>
  <reward kind="TM" amount="1" target="xScissor"/>
  <on event="questComplete">
    @wildmoorContestOfficer{vo}: A first prize! Your name goes on the board by the desk, under last year's winner, who was a very determined eight-year-old.
  </on>
</quest>
