---
kind: quest
id: isles.quests
title: The Sunfall Isles
---

// AREA isles: the postgame quests of the Sunfall Isles. Every quest here is a
// run quest (defaults.questTier).

// ── The beacons (accepted on arrival at Sunport, isles.arrival) ──────────────
// One subquest per island, in any order; the shrine opens when all three burn.
<quest id="islesBeacons" title="The Sunfall beacons">
  <objective id="ember" title="Relight the Emberkey beacon" quest="islesEmberkey"/>
  <objective id="mistral" title="Relight the Mistral beacon" quest="islesMistral"/>
  <objective id="coral" title="Relight the Coralreach beacon" quest="islesCoralreach"/>
  <objective id="nyx" title="Stop Admin Nyx in the Sunfall Shrine" done="holds('defeated', ['duskAdminNyx'])"/>
  <on event="questComplete">
    @sunportSage{code="0010" emotion="happy"}: Three beacons, and the shrine quiet again. The boats will sail tonight, Champion.
  </on>
</quest>

<quest id="islesEmberkey" title="Emberkey's beacon">
  <objective id="lens" title="Take the lens back from the grunt in the beacon" done="holds('islesLensBack', ['emberkey'])"/>
  <objective id="relight" title="Bring it to Keeper Brand" done="holds('islesRelit', ['emberkey'])"/>
</quest>

<quest id="islesMistral" title="Mistral's beacon">
  <objective id="vanes" title="Turn the windmill's sails into the wind" done="run.islesVanes >= 3"/>
  <objective id="lens" title="Take the lens back from the grunt in the loft" done="holds('islesLensBack', ['mistral'])"/>
  <objective id="relight" title="Bring it to Keeper Sorrel" done="holds('islesRelit', ['mistral'])"/>
</quest>

<quest id="islesCoralreach" title="Coralreach's beacon">
  <objective id="lens" title="Take the lens back from the grunt in the sea cave (low tide)" done="holds('islesLensBack', ['coralreach'])"/>
  <objective id="relight" title="Bring it to Keeper Nerissa" done="holds('islesRelit', ['coralreach'])"/>
</quest>

// ── Monster Center board: the Coralreach courier ────────────────────────────
// Accepted from the board (engine). Nerissa's medicine must reach her before
// nightfall: the objective fails at the first settle that is night.
<quest id="islesCourier" title="Board: medicine for Coralreach" accept="external">
  <objective id="deliver" title="Bring Keeper Nerissa her medicine before nightfall" on="talk" target="npc.coralreachKeeper" done="true" by="@isNight"/>
  <reward kind="ITEM" target="sitrusBerry" amount="3"/>
  <on event="questFailed">
    @narrator{code="0010"}: Night falls over Coralreach. Somebody else will have to take Nerissa her medicine.
  </on>
</quest>

// ── The Battle Tower's weekly challenge ─────────────────────────────────────
// Every Monday the tower posts a new challenge: three wins in a row. The
// streak counter is the engine's to reset on Monday (run.islesTowerStreak).
<quest id="islesTowerWeek" title="The Battle Tower: this week's streak" start="@champion" rearm="clock.weekday == 0">
  <objective id="three" title="Win three battles in a row at the Battle Tower" done="run.islesTowerStreak >= 3"/>
  <reward kind="MONEY" amount="3000"/>
</quest>
