---
component: gymLeader
effects: true
params:
  who: speaker     # the leader (a gymLeader member, in the cast)
  badge: { domain: badge }  # the badge it awards; its label ("Stone Badge") is shown (0.27)
  intro: string
  win: string      # the player won: the leader hands over the badge
  lose: string     # the player lost
  prize: int
---

## Gym leader
/* The leader on stage speaking as themself (`@@who`), the battle, and on a
win the badge. The outcome is this component's own ::battle result. */
::actor{character=@who action="enter"}
@@who{code="0010"}: {{@intro}}
::music{playback="change" mood="battle" volume="up"}
::battle{foe=@who kind="gym" resultKey="fight"}
<match subject="scene.battle.fight.won">
  <when is="true">
    @@who{code="0020"}: {{@win}}
    ::assert{defeated(@who)}
    ::assert{hasBadge(@badge)}
    ::set{run.money += @prize}
    ::sfx{sound="badge-fanfare"}
    @narrator{code="0010"}: {{userName}} received the {{@badge}}!
  </when>
  <otherwise>
    @@who{code="0030"}: {{@lose}}
  </otherwise>
</match>
