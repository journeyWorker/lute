---
component: trainerBattle
effects: true
params:
  who: speaker     # the trainer: a cast member (its name is the box label),
                   # trainer.<who>, defeated(<who>)
  intro: string    # the line of sight line
  win: string      # the player won: the trainer's defeat line
  lose: string     # the player lost: the trainer's gloat
  prize: number    # prize money on a win
# A beat template (0.27): `<beat use="trainerBattle" id="<who>" who="<who>" …/>`
# is the whole trainer. It answers trainerSpotted@trainer.<who> and stays
# repeatable until the trainer is beaten (spentBy). The defeat check is the
# spend condition, not the `when`, so a use may write its own `when=` (a
# night-only trainer: when="@isNight") without dropping it.
beat:
  on: trainerSpotted
  target: trainer.@who
  spentBy: "holds(defeated(@who))"
---

## Trainer battle

/* A route trainer: sight line, the battle, then the outcome. The trainer
   speaks as itself (`@@who`, its cast name on the box), and the outcome is
   this component's own ::battle result. A beat use's own lines (a grunt's
   shout before the sight line) play first. */
::body
@@who: {{@intro}}
::battle{foe=@who kind="trainer" resultKey="fight"}
<match on="scene.battle.fight.won">
  <when is="true">
    @@who: {{@win}}
    ::assert{defeated(@who)}
    ::set{run.money += @prize}
    @narrator: {{userName}} got {{@prize}} coins for winning!
  </when>
  <otherwise>
    @@who: {{@lose}}
  </otherwise>
</match>
