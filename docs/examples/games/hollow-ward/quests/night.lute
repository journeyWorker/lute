---
kind: quest
id: night
---

<quest id="findTobias" title="Find Tobias" start="true" fail="@dead || (@out && !@withToby)">
  <objective id="find" title="Find where they put him" done="@withToby"/>
  <objective id="out" title="Get him through the gate" done="@out && @withToby"/>
  <on event="questComplete">
    @tobias{code="0010"}: You came in. I told you not to come in.
    @nell{code="0010"}: You tell me a lot of things.
  </on>
  <on event="questFailed">
    @narrator{code="0010" when="quest.findTobias.failedBy == 'fail' && @out"}: Some nights, driving past, you swear the dome light in his car is on.
  </on>
</quest>

<quest id="beforeDawn" title="Get out before dawn" start="true" fail="@dead">
  <objective id="leave" title="Through the gate before first light" done="@out"/>
  <on event="questFailed">
    @narrator{code="0010" when="run.fate == 'lost'"}: The ward keeps its night. It has kept it for forty years; it can keep yours.
  </on>
</quest>

<quest id="quietWard" title="Let them sleep" start="entry.diary.read">
  <objective id="burn" title="Burn the admissions ledger" done="holds('burned', ['ledger'])"/>
  <objective id="bell" title="Ring the round down at three" done="run.bellRung"/>
  <on event="questActive">
    @nell{code="0010" mono}: Burn the ledger. Ring the bell at three. A dead man's to-do list.
  </on>
  <on event="questComplete">
    @narrator{code="0010"}: All through the building, very quietly, beds stop creaking.
  </on>
</quest>
