---
kind: scene
character: demo
season: 1
episode: 3
state:
  scene.score: { type: int, default: 0 }
  scene.flag: { type: bool, default: false }
defs:
  atLeast: { type: bool, params: { n: int }, cel: "scene.score >= 1" }
---

## The Parameterized Guard

<match subject="scene.flag">
  <when test="@atLeast(3)">
    @narrator: high enough
  </when>
  <otherwise>
    @narrator: not yet
  </otherwise>
</match>
