{
  "schemaVersion": 2,
  "locales": [
    "ko"
  ],
  "entries": {
    "market.closingBell.prompt": {
      "ko": "항구의 종이 울립니다. 옛 마을 회관을 어떻게 할까요?"
    },
    "market.closingBell.restore": {
      "ko": "주민 회관으로 되살린다"
    },
    "market.closingBell.retire": {
      "ko": "건물을 물때와 함께 쉬게 둔다"
    },
    "market.closingBell.wait": {
      "ko": "종이 다시 울릴 때까지 기다린다"
    },
    "market.june_0010": {
      "ko": "가게마다 고치거나, 바꾸거나, 기억할 것이 있어."
    },
    "market.june_0020": {
      "ko": "등불과 이웃들로 가득 채우자."
    },
    "market.june_0030": {
      "ko": "결정하기 전에 저녁 하나쯤은 더 보내도 돼."
    },
    "market.june_0040": {
      "ko": "어떤 문은 조용히 닫혀. 그것도 돌봄의 한 방식이야."
    },
    "market.narrator_0010": {
      "ko": "광장은 회관을 위해 불을 밝혀 둡니다."
    },
    "market.narrator_0020": {
      "ko": "옛 회관 주위로 광장이 조용해집니다."
    },
    "market.narrator_0030": {
      "ko": "종은 당신의 대답을 기다립니다."
    },
    "marketBark.june_0010": {
      "ko": "갓 구운 빵, 손질한 그물, 그리고 해 지기 전 이야기 하나 더."
    },
    "opening.june_0010": {
      "ko": "회관 등불이 밤새 타올랐어. 다시 와 줘서 반가워."
    },
    "opening.june_0020": {
      "ko": "옛 회관은 잠들었지만, 마을은 너를 기억해."
    },
    "opening.june_0030": {
      "ko": "물이 빠졌고, 키사이드는 벌써 깨어 있어."
    },
    "opening.narrator_0010": {
      "ko": "지금까지 종에 답한 횟수: {{user.endings}}."
    },
    "opening.narrator_0020": {
      "ko": "손으로 칠한 표지판이 광장과 부두와 빵집을 가리킵니다."
    },
    "pierBark.tom_0010": {
      "ko": "헐거운 판자 조심해. 부두는 폭풍을 하나도 잊지 않아."
    },
    "tide.narrator_0010": {
      "ko": "저녁 물때가 되자 마을 불빛이 하나씩 켜집니다."
    }
  },
