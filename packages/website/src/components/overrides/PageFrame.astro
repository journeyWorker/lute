---
import Default from "@astrojs/starlight/components/PageFrame.astro";
import { isLanding } from "../../lib/route";

const landing = isLanding(Astro.locals.starlightRoute);
---

{
  landing ? (
    <div class="gb-frame">
      <slot />
    </div>
  ) : (
    <Default>
      <slot name="header" slot="header" />
      <slot name="sidebar" slot="sidebar" />
      <slot />
    </Default>
  )
}
