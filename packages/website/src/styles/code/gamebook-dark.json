{
  "name": "gamebook-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#181a17",
    "editor.foreground": "#efefea",
    "editor.selectionBackground": "#12341f",
    "editorLineNumber.foreground": "#9b9b94",
    "terminal.background": "#181a17",
    "terminal.foreground": "#efefea",
    "titleBar.border": "#6a6a64",
    "editorGroupHeader.tabsBackground": "#181a17",
    "editorGroupHeader.tabsBorder": "#6a6a64",
    "tab.activeBackground": "#181a17",
    "tab.activeForeground": "#efefea",
    "titleBar.activeBackground": "#0a0a0a",
    "titleBar.activeForeground": "#f8f8f7",
    "focusBorder": "#6cc493",
    "scrollbarSlider.background": "#6a6a6466",
    "scrollbarSlider.hoverBackground": "#9b9b94aa"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#efefea"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a3a39c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "keyword.operator",
        "punctuation.separator",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#c4c4bd"
      }
    },
    {
      "name": "Keywords, tags, directives",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "entity.name.tag",
        "punctuation.definition.tag",
        "meta.tag punctuation.definition.tag",
        "entity.name.function.directive",
        "punctuation.definition.directive",
        "support.function.builtin",
        "variable.language",
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#7fd3a2"
      }
    },
    {
      "name": "Speakers and section headings",
      "scope": [
        "entity.name.type.speaker",
        "entity.name.section",
        "markup.heading",
        "punctuation.definition.heading",
        "entity.name.type",
        "entity.name.class",
        "support.class"
      ],
      "settings": {
        "foreground": "#7fd3a2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string",
        "string.template",
        "markup.inline.raw",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#ff8f78"
      }
    },
    {
      "name": "Dialogue prose stays in ink",
      "scope": [
        "string.unquoted.dialogue"
      ],
      "settings": {
        "foreground": "#efefea"
      }
    },
    {
      "name": "Attributes, numbers, constants, properties",
      "scope": [
        "entity.other.attribute-name",
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant",
        "support.type.property-name",
        "meta.object-literal.key",
        "variable.other.property",
        "variable.parameter",
        "variable.other.entity",
        "entity.name.function",
        "support.function",
        "meta.property-name",
        "entity.name.tag.yaml",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#a9b3ff"
      }
    },
    {
      "name": "Shell commands",
      "scope": [
        "entity.name.command",
        "support.function.builtin.shell"
      ],
      "settings": {
        "foreground": "#7fd3a2"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#efefea"
      }
    },
    {
      "name": "Diff",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#7fd3a2"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ff8f78"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#ff8f78",
        "fontStyle": "underline"
      }
    }
  ]
}
