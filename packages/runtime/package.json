{
  "name": "@lute-lang/runtime",
  "version": "0.39.0",
  "description": "The Lute runtime for TypeScript hosts, in Effect: load a compiled Lute bundle, drive the resumable step function, replay input logs (Bun and browsers).",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/journeyWorker/lute.git",
    "directory": "packages/runtime"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "import": "./dist/bun.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "wasm:build": "bun scripts/wasm-build.ts",
    "wasm:build:release": "bun scripts/wasm-build.ts --release",
    "wasm:build:test-panic": "bun scripts/wasm-build.ts --test-panic",
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bunx --bun vitest run",
    "test:browser": "bunx --bun vitest run --config vitest.browser.config.ts",
    "contract:gen": "bun scripts/contract-codegen.ts",
    "contract:check": "cargo run -q -p lute-runtime --features json-schema --bin lute-contract-schema && bun scripts/contract-codegen.ts && git diff --exit-code -- ../../schemas src/generated"
  },
  "peerDependencies": {
    "effect": "4.0.2",
    "@effect/platform-bun": "4.0.2",
    "@effect/platform-browser": "4.0.2"
  },
  "peerDependenciesMeta": {
    "@effect/platform-bun": {
      "optional": true
    },
    "@effect/platform-browser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/platform-browser": "4.0.2",
    "@effect/platform-bun": "4.0.2",
    "@effect/vitest": "4.0.2",
    "@types/bun": "1.4.2",
    "@vitest/browser-playwright": "5.0.3",
    "effect": "4.0.2",
    "playwright": "1.64.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "private": false
}
