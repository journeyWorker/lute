<quest id="q0089" title="Quest 89" start="user.s9.k4m14 >= 0 && user.s0.k0m1 >= 0 && quest.q0088.state == 'complete'">
  <objective id="a" title="Step A" done="user.s1.k1m2 >= 1"/>
  <objective id="b" title="Step B" done="user.s2.k2m4 >= 2 || user.s3.k3m14 >= 1"/>
  <on event="questComplete">
    ::set{user.s4.k4m0 += 1}
    ::set{user.s5.k0m1 += 1}
  </on>
</quest>
