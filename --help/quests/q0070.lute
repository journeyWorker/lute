---
kind: quest
uses: ../schema/world.schema.yaml
---

<quest id="q0070" title="Quest 70" start="user.s0.k0m10 >= 0 && user.s1.k1m12 >= 0 && quest.q0069.state == 'complete'">
  <objective id="a" title="Step A" done="user.s2.k2m13 >= 1"/>
  <objective id="b" title="Step B" done="user.s3.k3m0 >= 2 || user.s4.k4m10 >= 1"/>
  <on event="questComplete">
    ::set{user.s5.k0m11 += 1}
    ::set{user.s6.k1m12 += 1}
  </on>
</quest>
