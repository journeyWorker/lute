<quest id="q0019" title="Quest 19" start="user.s9.k4m4 >= 0 && user.s0.k0m6 >= 0 && quest.q0018.state == 'complete'">
  <objective id="a" title="Step A" done="user.s1.k1m7 >= 1"/>
  <objective id="b" title="Step B" done="user.s2.k2m9 >= 2 || user.s3.k3m4 >= 1"/>
  <on event="questComplete">
    ::set{user.s4.k4m5 += 1}
    ::set{user.s5.k0m6 += 1}
  </on>
</quest>
