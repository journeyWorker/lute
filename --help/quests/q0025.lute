<quest id="q0025" title="Quest 25" start="user.s5.k0m10 >= 0 && user.s6.k1m12 >= 0 && quest.q0024.state == 'complete'">
  <objective id="a" title="Step A" done="user.s7.k2m13 >= 1"/>
  <objective id="b" title="Step B" done="user.s8.k3m0 >= 2 || user.s9.k4m10 >= 1"/>
  <on event="questComplete">
    ::set{user.s0.k0m11 += 1}
    ::set{user.s1.k1m12 += 1}
  </on>
</quest>
