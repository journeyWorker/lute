<quest id="q0037" title="Quest 37" start="user.s7.k2m7 >= 0 && user.s8.k3m9 >= 0 && quest.q0036.state == 'complete'">
  <objective id="a" title="Step A" done="user.s9.k4m10 >= 1"/>
  <objective id="b" title="Step B" done="user.s0.k0m12 >= 2 || user.s1.k1m7 >= 1"/>
  <on event="questComplete">
    ::set{user.s2.k2m8 += 1}
    ::set{user.s3.k3m9 += 1}
  </on>
</quest>
