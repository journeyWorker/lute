---
kind: quest
uses: ../schema/world.schema.yaml
---

<quest id="q0014" title="Quest 14" start="user.s4.k4m14 >= 0 && user.s5.k0m1 >= 0 && quest.q0013.state == 'complete'">
  <objective id="a" title="Step A" done="user.s6.k1m2 >= 1"/>
  <objective id="b" title="Step B" done="user.s7.k2m4 >= 2 || user.s8.k3m14 >= 1"/>
  <on event="questComplete">
    ::set{user.s9.k4m0 += 1}
    ::set{user.s0.k0m1 += 1}
  </on>
</quest>
