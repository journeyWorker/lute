---
kind: quest
uses: ../schema/world.schema.yaml
---

<quest id="q0016" title="Quest 16" start="user.s6.k1m1 >= 0 && user.s7.k2m3 >= 0 && quest.q0015.state == 'complete'">
  <objective id="a" title="Step A" done="user.s8.k3m4 >= 1"/>
  <objective id="b" title="Step B" done="user.s9.k4m6 >= 2 || user.s0.k0m1 >= 1"/>
  <on event="questComplete">
    ::set{user.s1.k1m2 += 1}
    ::set{user.s2.k2m3 += 1}
  </on>
</quest>
