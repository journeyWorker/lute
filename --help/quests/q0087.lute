<quest id="q0087" title="Quest 87" start="user.s7.k2m12 >= 0 && user.s8.k3m14 >= 0 && quest.q0086.state == 'complete'">
  <objective id="a" title="Step A" done="user.s9.k4m0 >= 1"/>
  <objective id="b" title="Step B" done="user.s0.k0m2 >= 2 || user.s1.k1m12 >= 1"/>
  <on event="questComplete">
    ::set{user.s2.k2m13 += 1}
    ::set{user.s3.k3m14 += 1}
  </on>
</quest>
