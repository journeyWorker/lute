<quest id="q0042" title="Quest 42" start="user.s2.k2m12 >= 0 && user.s3.k3m14 >= 0 && quest.q0041.state == 'complete'">
  <objective id="a" title="Step A" done="user.s4.k4m0 >= 1"/>
  <objective id="b" title="Step B" done="user.s5.k0m2 >= 2 || user.s6.k1m12 >= 1"/>
  <on event="questComplete">
    ::set{user.s7.k2m13 += 1}
    ::set{user.s8.k3m14 += 1}
  </on>
</quest>
