---
kind: quest
uses: ../schema/world.schema.yaml
---

<quest id="q0015" title="Quest 15" start="user.s5.k0m0 >= 0 && user.s6.k1m2 >= 0 && quest.q0014.state == 'complete'">
  <objective id="a" title="Step A" done="user.s7.k2m3 >= 1"/>
  <objective id="b" title="Step B" done="user.s8.k3m5 >= 2 || user.s9.k4m0 >= 1"/>
  <on event="questComplete">
    ::set{user.s0.k0m1 += 1}
    ::set{user.s1.k1m2 += 1}
  </on>
</quest>
