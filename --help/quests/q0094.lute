<quest id="q0094" title="Quest 94" start="user.s4.k4m4 >= 0 && user.s5.k0m6 >= 0 && quest.q0093.state == 'complete'">
  <objective id="a" title="Step A" done="user.s6.k1m7 >= 1"/>
  <objective id="b" title="Step B" done="user.s7.k2m9 >= 2 || user.s8.k3m4 >= 1"/>
  <on event="questComplete">
    ::set{user.s9.k4m5 += 1}
    ::set{user.s0.k0m6 += 1}
  </on>
</quest>
