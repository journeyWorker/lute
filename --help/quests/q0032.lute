---
kind: quest
uses: ../schema/world.schema.yaml
---

<quest id="q0032" title="Quest 32" start="user.s2.k2m2 >= 0 && user.s3.k3m4 >= 0 && quest.q0031.state == 'complete'">
  <objective id="a" title="Step A" done="user.s4.k4m5 >= 1"/>
  <objective id="b" title="Step B" done="user.s5.k0m7 >= 2 || user.s6.k1m2 >= 1"/>
  <on event="questComplete">
    ::set{user.s7.k2m3 += 1}
    ::set{user.s8.k3m4 += 1}
  </on>
</quest>
