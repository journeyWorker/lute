<quest id="q0054" title="Quest 54" start="user.s4.k4m9 >= 0 && user.s5.k0m11 >= 0 && quest.q0053.state == 'complete'">
  <objective id="a" title="Step A" done="user.s6.k1m12 >= 1"/>
  <objective id="b" title="Step B" done="user.s7.k2m14 >= 2 || user.s8.k3m9 >= 1"/>
  <on event="questComplete">
    ::set{user.s9.k4m10 += 1}
    ::set{user.s0.k0m11 += 1}
  </on>
</quest>
