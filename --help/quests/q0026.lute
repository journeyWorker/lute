<quest id="q0026" title="Quest 26" start="user.s6.k1m11 >= 0 && user.s7.k2m13 >= 0 && quest.q0025.state == 'complete'">
  <objective id="a" title="Step A" done="user.s8.k3m14 >= 1"/>
  <objective id="b" title="Step B" done="user.s9.k4m1 >= 2 || user.s0.k0m11 >= 1"/>
  <on event="questComplete">
    ::set{user.s1.k1m12 += 1}
    ::set{user.s2.k2m13 += 1}
  </on>
</quest>
