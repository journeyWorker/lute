<quest id="q0023" title="Quest 23" start="user.s3.k3m8 >= 0 && user.s4.k4m10 >= 0 && quest.q0022.state == 'complete'">
  <objective id="a" title="Step A" done="user.s5.k0m11 >= 1"/>
  <objective id="b" title="Step B" done="user.s6.k1m13 >= 2 || user.s7.k2m8 >= 1"/>
  <on event="questComplete">
    ::set{user.s8.k3m9 += 1}
    ::set{user.s9.k4m10 += 1}
  </on>
</quest>
