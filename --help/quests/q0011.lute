---
kind: quest
uses: ../schema/world.schema.yaml
---

<quest id="q0011" title="Quest 11" start="user.s1.k1m11 >= 0 && user.s2.k2m13 >= 0 && quest.q0010.state == 'complete'">
  <objective id="a" title="Step A" done="user.s3.k3m14 >= 1"/>
  <objective id="b" title="Step B" done="user.s4.k4m1 >= 2 || user.s5.k0m11 >= 1"/>
  <on event="questComplete">
    ::set{user.s6.k1m12 += 1}
    ::set{user.s7.k2m13 += 1}
  </on>
</quest>
