---
kind: quest
uses: ../schema/world.schema.yaml
---

<quest id="q0030" title="Quest 30" start="user.s0.k0m0 >= 0 && user.s1.k1m2 >= 0 && quest.q0029.state == 'complete'">
  <objective id="a" title="Step A" done="user.s2.k2m3 >= 1"/>
  <objective id="b" title="Step B" done="user.s3.k3m5 >= 2 || user.s4.k4m0 >= 1"/>
  <on event="questComplete">
    ::set{user.s5.k0m1 += 1}
    ::set{user.s6.k1m2 += 1}
  </on>
</quest>
