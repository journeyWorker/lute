---
kind: quest
uses: ../schema/world.schema.yaml
---

<quest id="q0020" title="Quest 20" start="user.s0.k0m5 >= 0 && user.s1.k1m7 >= 0 && quest.q0019.state == 'complete'">
  <objective id="a" title="Step A" done="user.s2.k2m8 >= 1"/>
  <objective id="b" title="Step B" done="user.s3.k3m10 >= 2 || user.s4.k4m5 >= 1"/>
  <on event="questComplete">
    ::set{user.s5.k0m6 += 1}
    ::set{user.s6.k1m7 += 1}
  </on>
</quest>
