<quest id="q0098" title="Quest 98" start="user.s8.k3m8 >= 0 && user.s9.k4m10 >= 0 && quest.q0097.state == 'complete'">
  <objective id="a" title="Step A" done="user.s0.k0m11 >= 1"/>
  <objective id="b" title="Step B" done="user.s1.k1m13 >= 2 || user.s2.k2m8 >= 1"/>
  <on event="questComplete">
    ::set{user.s3.k3m9 += 1}
    ::set{user.s4.k4m10 += 1}
  </on>
</quest>
