<quest id="q0047" title="Quest 47" start="user.s7.k2m2 >= 0 && user.s8.k3m4 >= 0 && quest.q0046.state == 'complete'">
  <objective id="a" title="Step A" done="user.s9.k4m5 >= 1"/>
  <objective id="b" title="Step B" done="user.s0.k0m7 >= 2 || user.s1.k1m2 >= 1"/>
  <on event="questComplete">
    ::set{user.s2.k2m3 += 1}
    ::set{user.s3.k3m4 += 1}
  </on>
</quest>
