---
kind: quest
uses: ../schema/world.schema.yaml
---

<quest id="q0093" title="Quest 93" start="user.s3.k3m3 >= 0 && user.s4.k4m5 >= 0 && quest.q0092.state == 'complete'">
  <objective id="a" title="Step A" done="user.s5.k0m6 >= 1"/>
  <objective id="b" title="Step B" done="user.s6.k1m8 >= 2 || user.s7.k2m3 >= 1"/>
  <on event="questComplete">
    ::set{user.s8.k3m4 += 1}
    ::set{user.s9.k4m5 += 1}
  </on>
</quest>
