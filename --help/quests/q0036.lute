---
kind: quest
uses: ../schema/world.schema.yaml
---

<quest id="q0036" title="Quest 36" start="user.s6.k1m6 >= 0 && user.s7.k2m8 >= 0 && quest.q0035.state == 'complete'">
  <objective id="a" title="Step A" done="user.s8.k3m9 >= 1"/>
  <objective id="b" title="Step B" done="user.s9.k4m11 >= 2 || user.s0.k0m6 >= 1"/>
  <on event="questComplete">
    ::set{user.s1.k1m7 += 1}
    ::set{user.s2.k2m8 += 1}
  </on>
</quest>
