## C

::check{skill="persuasion" dc="12" resultKey="guards" sync="true"}
<match subject="scene.check.guards.passed">
  <when is="true">
    @narrator: Passed.
    @narrator{when="scene.check.guards.margin > 5"}: Easily.
  </when>
  <when is="false">
    @narrator: Failed.
  </when>
</match>
::check{skill="stealth" dc="10" resultKey="sneak" sync="true"}
<match subject="scene.check.sneak.passed">
  <when is="true">
    @narrator: Sneaked.
  </when>
  <when is="false">
    @narrator: Spotted.
  </when>
</match>
