## Handcuffs

<match subject="run.accused">
  <when is="tilly">
    @narrator: Tilly.
  </when>
  <when is="hester">
    @narrator: Hester.
  </when>
  <when is="ruben">
    @narrator: Ruben.
  </when>
</match>
