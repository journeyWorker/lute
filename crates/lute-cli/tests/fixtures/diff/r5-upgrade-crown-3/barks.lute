---
kind: lore
id: barks
title: Barks
---

<entry id="again" on="bossDefeated" target="kind:foe" category="bark" once="run">
  <match subject="occasion.target">
    <when is="eel">
      @narrator: The eel again.
    </when>
    <when is="regent">
      @narrator: The Regent again.
    </when>
  </match>
</entry>
