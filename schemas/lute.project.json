{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lute.dev/schemas/lute.project.json",
  "title": "Lute project configuration",
  "description": "Configuration for lute.project.yaml. Permission fields are trusted project/host ceilings and are never source- or plugin-authored.",
  "type": "object",
  "required": [
    "defaultProfile"
  ],
  "properties": {
    "pluginsDir": {
      "type": "string"
    },
    "catalogDir": {
      "type": "string"
    },
    "defaultProfile": {
      "type": "string"
    },
    "permissions": {
      "$ref": "#/definitions/permissionSet"
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/profile"
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lineId": {
          "type": "string"
        },
        "voiceKey": {
          "type": "string"
        },
        "requireStable": {
          "type": "boolean",
          "default": false
        },
        "renames": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "defaults": {
      "type": "object"
    },
    "chapters": {
      "description": "Chains of scenes, one per occasion. Each listed scene (by id) gets on: <occasion> and a descending priority, and every scene but the first gets after: visited(\"<previous>\"), unless it writes the key itself. On a select: sequence occasion the chain derives no after: — the list is the order within one raise. On a targeted occasion every listed scene must declare target:.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["on", "scenes"],
        "properties": {
          "on": { "type": "string" },
          "scenes": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
    ,
    "constraints": {
      "type": "array",
      "items": { "$ref": "#/definitions/constraint" }
    }
  },
  "definitions": {
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["reachable", "completable", "speaksOnlyWhen", "noSingleSlotProgress"] },
        "severity": { "enum": ["error", "warning", "info"] },
        "node": { "type": "string", "minLength": 1 },
        "quest": { "type": "string", "minLength": 1 },
        "speaker": { "type": "string", "minLength": 1 },
        "when": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "reachable" } } },
          "then": {
            "required": ["node"],
            "not": { "anyOf": [{ "required": ["quest"] }, { "required": ["speaker"] }, { "required": ["when"] }] }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "completable" } } },
          "then": {
            "required": ["quest"],
            "not": { "anyOf": [{ "required": ["node"] }, { "required": ["speaker"] }, { "required": ["when"] }] }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "noSingleSlotProgress" } } },
          "then": {
            "required": ["quest"],
            "not": { "anyOf": [{ "required": ["node"] }, { "required": ["speaker"] }, { "required": ["when"] }] }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "speaksOnlyWhen" } } },
          "then": {
            "required": ["speaker", "when"],
            "not": { "anyOf": [{ "required": ["node"] }, { "required": ["quest"] }] }
          }
        }
      ]
    },
    "profile": {
      "type": "object",
      "properties": {
        "extends": {
          "type": "string"
        },
        "plugins": {
          "type": "object"
        },
        "permissions": {
          "$ref": "#/definitions/permissionSet"
        }
      }
    },
    "permissionSet": {
      "description": "One conjunctive permission ceiling. Missing fields are unrestricted; an explicit empty array denies that category. A single * permits every member in an array category.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directives": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(\\*|[A-Za-z][A-Za-z0-9_-]*)$"
          }
        },
        "stateWrites": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(\\*|[A-Za-z0-9_][A-Za-z0-9_-]*\\.(?:[A-Za-z0-9_][A-Za-z0-9_-]*\\.)*\\*|[A-Za-z0-9_][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_][A-Za-z0-9_-]*)+)$"
          }
        },
        "factWrites": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(\\*|[A-Za-z0-9_][A-Za-z0-9_-]*)$"
          }
        },
        "bridges": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(\\*|[A-Za-z][A-Za-z0-9_-]*/[A-Za-z][A-Za-z0-9_-]*)$"
          }
        },
        "rewards": {
          "type": "boolean"
        },
        "quests": {
          "type": "boolean"
        }
      }
    }
  }
}
