{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lute.dev/schemas/lute.plugin.json",
  "title": "Lute plugin manifest + export files",
  "description": "STRUCTURE-only schema for `plugin.yaml` (PluginManifest, plugin §5) and every export file kind it can `exports:` (plugin §6-10, §14, lint-system §6): directives, state/{shapes,templates}, providers, bridge, defs (LIST form), frontmatter, enums, events, assetKinds, stampAttrs, rewardKinds, occasions, cast, lints. Mirrors `crates/lute-manifest/src/schema.rs` 1:1 (each definition below is named after its Rust struct). `additionalProperties` is left permissive everywhere EXCEPT `plugin.yaml` itself (closed, as the loader refuses unknown keys) and two shapes borrowed from lute.schema.json — the `type:` tagged-map forms, whose `singleton_map_recursive` genuinely requires a closed single-key shape, and the `enums:` long form, closed deliberately AGAINST serde's silent tolerance because an unknown key there (a typo'd `exit:`) loses vocabulary semantics with no diagnostic. Otherwise none of these structs derive `#[serde(deny_unknown_fields)]`. A document matches exactly ONE of the `oneOf` branches below, discriminated by its own required top-level key (`directives:`, `stateShapes:`, `id:`+`version:`+`kind:`+`exports:`, …).",
  "oneOf": [
    {
      "$ref": "#/definitions/pluginManifest"
    },
    {
      "$ref": "#/definitions/directivesFile"
    },
    {
      "$ref": "#/definitions/shapesFile"
    },
    {
      "$ref": "#/definitions/templatesFile"
    },
    {
      "$ref": "#/definitions/providersFile"
    },
    {
      "$ref": "#/definitions/bridgeFile"
    },
    {
      "$ref": "#/definitions/defsFile"
    },
    {
      "$ref": "#/definitions/frontmatterFile"
    },
    {
      "$ref": "#/definitions/enumsFile"
    },
    {
      "$ref": "#/definitions/eventsFile"
    },
    {
      "$ref": "#/definitions/assetKindsFile"
    },
    {
      "$ref": "#/definitions/stampAttrsFile"
    },
    {
      "$ref": "#/definitions/rewardKindsFile"
    },
    {
      "$ref": "#/definitions/lintsFile"
    }
  ],
  "definitions": {
    "type": {
      "$ref": "https://lute.dev/schemas/lute.schema.json#/definitions/type"
    },
    "field": {
      "$ref": "https://lute.dev/schemas/lute.schema.json#/definitions/field"
    },
    "literal": {
      "$ref": "https://lute.dev/schemas/lute.schema.json#/definitions/literal"
    },
    "enumDecl": {
      "$ref": "https://lute.dev/schemas/lute.schema.json#/definitions/enumDecl"
    },
    "pluginManifest": {
      "description": "schema.rs::PluginManifest — plugin.yaml root. Closed: loader.rs refuses any other key (E-PLUGIN-KEY).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "kind",
        "exports"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "capability"
          ]
        },
        "depends": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/depends"
          }
        },
        "exports": {
          "type": "object",
          "description": "loader.rs's export dispatch — an unrecognized key is a real LoadError::UnknownExport.",
          "propertyNames": {
            "enum": [
              "directives",
              "state",
              "providers",
              "bridge",
              "defs",
              "enums",
              "frontmatter",
              "docs",
              "assetKinds",
              "events",
              "stampAttrs",
              "rewardKinds",
              "occasions",
              "lints",
              "cast"
            ]
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/optionDecl"
          }
        }
      }
    },
    "depends": {
      "description": "schema.rs::Depends.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "range"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "range": {
          "type": "string"
        }
      }
    },
    "optionDecl": {
      "description": "schema.rs::OptionDecl — a plugin.yaml `options:` entry.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/type"
        },
        "default": {
          "$ref": "#/definitions/literal"
        }
      }
    },
    "directivesFile": {
      "description": "schema.rs::DirectivesFile.",
      "type": "object",
      "required": [
        "directives"
      ],
      "properties": {
        "directives": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/directiveDecl"
          }
        }
      }
    },
    "directiveDecl": {
      "description": "schema.rs::DirectiveDecl.",
      "type": "object",
      "required": [
        "name",
        "attrs"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "layer": {
          "type": "string"
        },
        "attrs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/attrDecl"
          }
        },
        "semantics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Closed vocabulary — validated by the checker, not shape-checked here."
        },
        "state": {
          "$ref": "#/definitions/directiveState"
        },
        "effects": {
          "$ref": "#/definitions/directiveEffects"
        },
        "bridge": {
          "$ref": "#/definitions/bridgeRef"
        },
        "lower": {
          "$ref": "#/definitions/lowering",
          "description": "Optional (0.24.0): absent means the generic `kind: \"plugin\"` passthrough."
        }
      }
    },
    "attrDecl": {
      "description": "schema.rs::AttrDecl.",
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "type": {
          "$ref": "#/definitions/type"
        },
        "default": {
          "$ref": "#/definitions/literal"
        }
      }
    },
    "directiveState": {
      "description": "schema.rs::DirectiveState.",
      "type": "object",
      "required": [
        "declares"
      ],
      "properties": {
        "declares": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/slotDecl"
          }
        }
      }
    },
    "slotDecl": {
      "description": "schema.rs::SlotDecl.",
      "type": "object",
      "required": [
        "scope",
        "path",
        "shape"
      ],
      "properties": {
        "scope": {
          "type": "string"
        },
        "path": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/pathSegment"
          }
        },
        "shape": {
          "type": "string"
        }
      }
    },
    "pathSegment": {
      "description": "types.rs::PathSegment — untagged: a literal string, or `{ fromAttr: {...} }`.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "fromAttr"
          ],
          "properties": {
            "fromAttr": {
              "$ref": "#/definitions/fromAttr"
            }
          }
        }
      ]
    },
    "fromAttr": {
      "description": "types.rs::FromAttr (camelCase).",
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "slotType": {
          "type": "string"
        }
      }
    },
    "directiveEffects": {
      "description": "schema.rs::DirectiveEffects.",
      "type": "object",
      "required": [
        "writes"
      ],
      "properties": {
        "writes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/writeDecl"
          }
        }
      }
    },
    "writeDecl": {
      "description": "schema.rs::WriteDecl.",
      "type": "object",
      "required": [
        "scope",
        "path",
        "value"
      ],
      "properties": {
        "scope": {
          "type": "string"
        },
        "path": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/pathSegment"
          }
        },
        "value": {
          "$ref": "#/definitions/writeValue"
        }
      }
    },
    "writeValue": {
      "description": "schema.rs::WriteValue — untagged: `{ fromBridgeResult }` | `{ op, by }` | Literal.",
      "anyOf": [
        {
          "type": "object",
          "required": [
            "fromBridgeResult"
          ],
          "properties": {
            "fromBridgeResult": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "by"
          ],
          "properties": {
            "op": {
              "type": "string"
            },
            "by": {
              "type": "number"
            }
          }
        },
        {
          "$ref": "#/definitions/literal"
        }
      ]
    },
    "bridgeRef": {
      "description": "schema.rs::BridgeRef.",
      "type": "object",
      "required": [
        "service",
        "operation"
      ],
      "properties": {
        "service": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        }
      }
    },
    "lowering": {
      "description": "schema.rs::Lowering — untagged: `{ record, fields }` | `{ kind, name }`.",
      "anyOf": [
        {
          "type": "object",
          "required": [
            "record",
            "fields"
          ],
          "properties": {
            "record": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        }
      ]
    },
    "shapesFile": {
      "description": "schema.rs::ShapesFile — state/*.yaml `stateShapes:` form.",
      "type": "object",
      "required": [
        "stateShapes"
      ],
      "properties": {
        "stateShapes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/stateShape"
          }
        }
      }
    },
    "stateShape": {
      "description": "schema.rs::StateShape.",
      "type": "object",
      "required": [
        "name",
        "fields"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/field"
          }
        }
      }
    },
    "templatesFile": {
      "description": "schema.rs::TemplatesFile — state/*.yaml `stateTemplates:` form.",
      "type": "object",
      "required": [
        "stateTemplates"
      ],
      "properties": {
        "stateTemplates": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/stateTemplate"
          }
        }
      }
    },
    "stateTemplate": {
      "description": "schema.rs::StateTemplate.",
      "type": "object",
      "required": [
        "name",
        "scope",
        "path",
        "shape"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "path": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/pathSegment"
          }
        },
        "shape": {
          "type": "string"
        }
      }
    },
    "providersFile": {
      "description": "schema.rs::ProvidersFile.",
      "type": "object",
      "required": [
        "providers"
      ],
      "properties": {
        "providers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/providerDecl"
          }
        }
      }
    },
    "providerDecl": {
      "description": "schema.rs::ProviderDecl.",
      "type": "object",
      "required": [
        "name",
        "snapshot"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "idShape": {
          "type": "string"
        },
        "snapshot": {
          "type": "string"
        }
      }
    },
    "bridgeFile": {
      "description": "schema.rs::BridgeFile.",
      "type": "object",
      "required": [
        "bridgeCapabilities"
      ],
      "properties": {
        "bridgeCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/bridgeCapability"
          }
        }
      }
    },
    "bridgeCapability": {
      "description": "schema.rs::BridgeCapability.",
      "type": "object",
      "required": [
        "service",
        "operation"
      ],
      "properties": {
        "service": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "replay": {
          "type": "string"
        },
        "result": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/field"
          }
        }
      }
    },
    "defsFile": {
      "description": "schema.rs::DefsFile — defs/*.yaml `defs:` LIST form (each entry a full DefDecl, unlike a project doc's inline `defs:` MAP).",
      "type": "object",
      "required": [
        "defs"
      ],
      "properties": {
        "defs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/defDecl"
          }
        }
      }
    },
    "defDecl": {
      "description": "schema.rs::DefDecl — `name`/`type`/`cel` have no serde default, so they are genuinely required.",
      "type": "object",
      "required": [
        "name",
        "type",
        "cel"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/type"
        },
        "params": {
          "$ref": "https://lute.dev/schemas/lute.schema.json#/definitions/params"
        },
        "cel": {
          "type": "string"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "host": {
          "description": "0.41.0 §3.5: the host reads this def (exempt from W-DEF-UNUSED; exported as `host: true` in the index `defs`).",
          "type": "boolean"
        }
      }
    },
    "frontmatterFile": {
      "description": "schema.rs::FrontmatterFile.",
      "type": "object",
      "required": [
        "frontmatter"
      ],
      "properties": {
        "frontmatter": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/frontmatterDecl"
          }
        }
      }
    },
    "frontmatterDecl": {
      "description": "schema.rs::FrontmatterDecl.",
      "type": "object",
      "required": [
        "key",
        "schema"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "schema": {
          "$ref": "#/definitions/type"
        }
      }
    },
    "enumsFile": {
      "description": "schema.rs::EnumsFile — enums.yaml `enums:` (`BTreeMap<String, EnumDecl>`, the same shape as a project doc's `enums:`, so both routes share lute.schema.json's `enumDecl`). Each entry is either the bare `[member...]` sequence or the dsl 0.9.0 D-D long form `{ members:, default:, exits: }`; see that definition for why `default:`/`exits:` stay optional here and unknown keys do not.",
      "type": "object",
      "required": [
        "enums"
      ],
      "properties": {
        "enums": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/enumDecl"
          }
        }
      }
    },
    "eventsFile": {
      "description": "schema.rs::EventsFile.",
      "type": "object",
      "required": [
        "events"
      ],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/eventDecl"
          }
        }
      }
    },
    "eventDecl": {
      "description": "schema.rs::EventDecl.",
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "stampAttrsFile": {
      "description": "schema.rs::StampAttrsFile (export `stampAttrs`, plugin §14.1, 0.50.0 §3.1). Each entry is a stampAttrEntry: an attrDecl plus an optional `on:` surface list. Without `on:` the entry is CROSS-CUTTING, admissible on every directive with a stamp carrier AND on content lines; with `on:` exactly on the named surfaces. A stamp lowers into the IR record's nested `stamps` object (0.49.0 §3.1) rather than its own fields. A name colliding with a key the core stamp owns (`at`/`duration`/`delay`/`wait`/`timeline`/`timing`/`provenance`/`source`) is an assembly-time E-PLUGIN-RESERVED-STAMP-ATTR; a `list`/`map`/`record` type, which no authored attribute value can satisfy, is E-PLUGIN-INVALID-DIRECTIVE (0.49.0 §3.2). An unauthored stamp is never default-injected; `required: true` needs `on:` (E-PLUGIN-PARSE).",
      "type": "object",
      "required": [
        "stampAttrs"
      ],
      "properties": {
        "stampAttrs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/stampAttrEntry"
          }
        }
      }
    },
    "stampAttrEntry": {
      "description": "schema.rs::StampAttrEntry: the attrDecl fields plus `on:` (0.50.0 §3.1), a non-empty list of surface names: `line`, `branch`, `hub`, `choice`, or a directive of the resolved profile with a stamp carrier (not `jump`/`label`/`clear`). An unknown or unstamped surface is E-PLUGIN-STAMP-SURFACE at assembly; a scoped name its surface already owns is E-PLUGIN-RESERVED-STAMP-ATTR. Two entries of one name need disjoint `on:` surfaces (E-PLUGIN-DUP-ID / E-PLUGIN-DUP-ACROSS).",
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "type": {
          "$ref": "#/definitions/type"
        },
        "default": {
          "$ref": "#/definitions/literal"
        },
        "on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "lintsFile": {
      "description": "schema.rs::LintsFile (export `lints/*.yaml`, lint-system design §6). A sequence of lintRuleDecl entries a plugin publishes. Excluded from `CapabilitySnapshot` and `capabilitySnapshot` by construction — lints are advisory and must never change artifact identity (design §1 non-goals).",
      "type": "object",
      "required": [
        "lints"
      ],
      "properties": {
        "lints": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/lintRuleDecl"
          }
        }
      }
    },
    "lintRuleDecl": {
      "description": "lint.rs::LintRuleDecl. `target` is one of `line | shot | scene | speaker | group | project`; `level` (optional) is one of `off | hint | info | warn | error`; `when` is a lint-CEL expression parsed by lute-lint at load time; `message` is a `{path.to.field}` template; `options` is an opaque YAML mapping the rule's own logic interprets. Consumers namespace the raw `id` as `<plugin-id>/<id>`.",
      "type": "object",
      "required": [
        "id",
        "target",
        "when",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "target": {
          "enum": [
            "line",
            "section",
            "scene",
            "speaker",
            "group",
            "project"
          ]
        },
        "when": {
          "type": "string"
        },
        "level": {
          "enum": [
            "off",
            "hint",
            "info",
            "warn",
            "error"
          ]
        },
        "message": {
          "type": "string"
        },
        "options": {
          "type": "object"
        }
      }
    },
    "rewardKindsFile": {
      "description": "schema.rs::RewardKindsFile (export `rewardKinds/*.yaml`, dsl 0.16.0 §4): a `rewardKinds:` mapping keyed by the reward kind id.",
      "type": "object",
      "required": [
        "rewardKinds"
      ],
      "properties": {
        "rewardKinds": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/rewardKindBody"
          }
        }
      }
    },
    "rewardKindBody": {
      "description": "schema.rs::RewardKindBody (closed, as the loader refuses unknown keys). `credits` (dsl 0.23.0 §8) is the state path a grant of the kind adds its amount to.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "$ref": "#/definitions/rewardTarget"
        },
        "attrs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/attrDecl"
          }
        },
        "credits": {
          "type": "string"
        }
      }
    },
    "rewardTarget": {
      "description": "schema.rs::RewardTarget (closed): the id space a `<reward target=…>` resolves against (dsl 0.16.0 §4, 0.26.0 §2.5). At most one of `provider`/`entity`; `required: true` rejects a reward with no `target=`. `forbidden: true` (0.49.0 §3.3) rejects a reward WITH a `target=`, and is exclusive with `provider`/`entity`/`required`.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string"
        },
        "entity": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "forbidden": {
          "type": "boolean"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "provider",
              "entity"
            ]
          },
          {
            "properties": {
              "forbidden": {
                "const": true
              }
            },
            "required": [
              "forbidden"
            ],
            "anyOf": [
              {
                "required": [
                  "provider"
                ]
              },
              {
                "required": [
                  "entity"
                ]
              },
              {
                "required": [
                  "required"
                ]
              }
            ]
          }
        ]
      }
    },
    "assetKindsFile": {
      "description": "schema.rs::AssetKindsFile.",
      "type": "object",
      "required": [
        "assetKinds"
      ],
      "properties": {
        "assetKinds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/assetKindDecl"
          }
        }
      }
