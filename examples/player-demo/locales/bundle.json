  "entries": {
    "chapter-one.elio_0010": {
      "ko": "아니면 아주 극적인 갈매기거나."
    },
    "chapter-one.elio_0020": {
      "ko": "현명하네. 게다가 더 따뜻하고."
    },
    "chapter-one.elio_0030": {
      "ko": "동풍이야. 정오쯤 비가 와. 우산은 하나 챙겼어."
    },
    "chapter-one.elio_0040": {
      "ko": "내 시간표엔 일곱 시에 아침밥이 있는데."
    },
    "chapter-one.elio_0050": {
      "ko": "진지하게 배고파."
    },
    "chapter-one.elio_0060": {
      "ko": "그럼 안개가 우리 이름을 외우기 전에 데려오자."
    },
    "chapter-one.elio_0070": {
      "ko": "나한텐 우산 하나랑 끔찍한 방향 감각이 있지."
    },
    "chapter-one.elio_0080": {
      "ko": "그럼 해 질 녘엔?"
    },
    "chapter-one.elio_0090": {
      "ko": "그럼 오늘이 우리를 골랐네."
    },
    "chapter-one.harborPromise.promise": {
      "ko": "함께 돌아오기로 약속한다"
    },
    "chapter-one.harborPromise.prompt": {
      "ko": "파란 리본이 등대 쪽으로 나부낀다."
    },
    "chapter-one.mara_0010": {
      "ko": "등대가 세 번 깜박였어. 날씨 신호가 아니야."
    },
    "chapter-one.mara_0020": {
      "ko": "엘리오."
    },
    "chapter-one.mara_0030": {
      "ko": "그럼 물이 길을 덮기 전에 올라가자."
    },
    "chapter-one.mara_0040": {
      "ko": "언니가 사라지던 밤에 보낸 신호야."
    },
    "chapter-one.mara_0050": {
      "ko": "그 신호는 미신으로 시작해서 시간표가 됐어."
    },
    "chapter-one.mara_0060": {
      "ko": "진지하게 하겠다고 약속했잖아."
    },
    "chapter-one.mara_0070": {
      "ko": "리오라가 안개 속으로 가기 전에 준 거야."
    },
    "chapter-one.mara_0080": {
      "ko": "정말 그래 줄 거야?"
    },
    "chapter-one.mara_0090": {
      "ko": "정오가 되면 등대 렌즈가 동쪽을 향해."
    },
    "chapter-one.mara_0100": {
      "ko": "해 질 녘엔 잃어버린 사람들 쪽으로 돌아."
    },
    "chapter-one.mara_0110": {
      "ko": "리오라 거야."
    },
    "chapter-one.mara_0120": {
      "ko": "곁에 있어. 무슨 일이 있어도 함께 답하자."
    },
    "chapter-one.mara_0130": {
      "ko": "우린 함께 돌아와."
    },
    "chapter-one.mara_0140": {
      "ko": "우리, 저 불빛을 향해 올라간 적이 있어. 아직도 그 물때가 기억나."
    },
    "chapter-one.narrator_0010": {
      "ko": "아침 여섯 시, 항구는 은빛 물결 아래에 비밀을 숨기고 있다."
    },
    "chapter-one.narrator_0020": {
      "ko": "안개 속에서 종이 답한다. 한 번. 두 번. 그리고 정적."
    },
    "chapter-one.narrator_0030": {
      "ko": "셋은 안개 속으로 발을 들인다."
    },
    "chapter-one.narrator_0040": {
      "ko": "마라는 코트 안쪽에 꿰매 둔 놋쇠 나침반을 확인한다."
    },
    "chapter-one.narrator_0050": {
      "ko": "주위에서 항구의 기중기들이 삐걱이며 깨어난다."
    },
    "chapter-one.narrator_0060": {
      "ko": "갈매기 한 마리가 파란 리본 한 가닥을 물고 난간에 내려앉는다."
    },
    "chapter-one.narrator_0070": {
      "ko": "지금까지 등대로 떠난 항해: {{user.voyages}}번."
    },
    "chapter-one.questions.leave": {
      "ko": "바로 떠난다"
    },
    "chapter-one.questions.past": {
      "ko": "마라에게 어떻게 신호를 아는지 묻는다"
    },
    "chapter-one.questions.prompt": {
      "ko": "안개가 기다린다. 떠나기 전에 무엇을 물을까?"
    },
    "chapter-one.questions.weather": {
      "ko": "엘리오에게 날씨를 묻는다"
    },
    "chapter-one.signal.harbor": {
      "ko": "항구에 남아 주변을 찾아본다"
    },
    "chapter-one.signal.prompt": {
      "ko": "등대 아래에서 물길이 바뀌고 있다."
    },
    "chapter-one.signal.tower": {
      "ko": "신호를 따라 등대로 간다"
    },
    "chapter-three.elio_0010": {
      "ko": "물이 계단을 타고 올라오고 있어."
    },
    "chapter-three.elio_0020": {
      "ko": "뭐라고 했는데?"
    },
    "chapter-three.elio_0030": {
      "ko": "리본도 가져왔어."
    },
    "chapter-three.elio_0040": {
      "ko": "그럼 놓아줘."
    },
    "chapter-three.elio_0050": {
      "ko": "쉬웠던 적은 없지. 그래서 간식을 챙겨 왔잖아."
    },
    "chapter-three.elio_0060": {
      "ko": "무슨 대답이든, 내가 곁에 있어."
    },
    "chapter-three.elio_0070": {
      "ko": "물때가 너그러울 때 읽자."
    },
    "chapter-three.journal.close": {
      "ko": "일기를 덮는다"
    },
    "chapter-three.journal.prompt": {
      "ko": "등불 옆에서 리오라의 일기가 기다린다."
    },
    "chapter-three.journal.read": {
      "ko": "마지막 장을 읽는다"
    },
    "chapter-three.lastLight.hold": {
      "ko": "등불을 닫아 둔다"
    },
    "chapter-three.lastLight.prompt": {
      "ko": "등불이 마지막 선택을 내민다."
    },
    "chapter-three.lastLight.release": {
      "ko": "빛을 바다로 놓아준다"
    },
    "chapter-three.mara_0010": {
      "ko": "리오라. 집에 가자."
    },
    "chapter-three.mara_0020": {
      "ko": "사랑했다는 걸 증명하려고 유령을 붙잡아 둘 필요는 없어."
    },
    "chapter-three.mara_0030": {
      "ko": "더는 우리에게서 빼앗아 가지 마."
    },
    "chapter-three.mara_0040": {
      "ko": "리오라가 처음 등불을 보여 줬던 때가 기억나."
    },
    "chapter-three.mara_0050": {
      "ko": "모든 빛은 대답인 척하는 질문이라고."
    },
    "chapter-three.mara_0060": {
      "ko": "리오라, 들린다면 대답해. 우리가 돌아왔어."
    },
    "chapter-three.mara_0070": {
      "ko": "나침반도."
    },
    "chapter-three.mara_0080": {
      "ko": "언니 글씨야."
    },
    "chapter-three.mara_0090": {
      "ko": "등대는 사람들이 놓아주지 못하는 것을 간직한다고 썼어."
    },
    "chapter-three.mara_0100": {
      "ko": "그렇게 쉽지 않아."
    },
    "chapter-three.mara_0110": {
      "ko": "이제 대답을 들을 준비가 됐어."
    },
    "chapter-three.mara_0120": {
      "ko": "그럼 마지막 빛이 제 해안을 고르게 하자."
    },
    "chapter-three.mara_0130": {
      "ko": "집으로 가는 길을 남겨 뒀어."
    },
    "chapter-three.narrator_0010": {
      "ko": "자정, 등불이 눈처럼 열린다. 잃어버린 언니이 그 빛 안에 서 있다."
    },
    "chapter-three.narrator_0020": {
      "ko": "빛이 물 위로 쏟아진다. 리오라가 미소 짓고, 항구가 깨어난다."
    },
    "chapter-three.narrator_0030": {
      "ko": "새벽 엔딩 — 신호는 약속이 된다."
    },
    "chapter-three.narrator_0040": {
      "ko": "등불이 흐려진다. 바다가 비밀을 싣고 물러난다."
    },
    "chapter-three.narrator_0050": {
      "ko": "황혼 엔딩 — 어떤 문은 우리를 지키려고 닫힌다."
    },
    "chapter-three.narrator_0060": {
      "ko": "등불의 파란 불꽃이 바다 쪽으로 기운다."
    },
    "chapter-three.narrator_0070": {
      "ko": "놋쇠 뚜껑 안에서 작은 일기장 한 장이 펼쳐진다."
    },
    "chapter-three.narrator_0080": {
      "ko": "한순간, 유령마저 웃는다."
    },
    "chapter-two.crossing.prompt": {
      "ko": "계단 위에서 종이 울린다. 다음 계단이 벌써 희미해진다."
    },
    "chapter-two.crossing.rush": {
      "ko": "등불을 향해 달린다"
    },
    "chapter-two.crossing.steady": {
      "ko": "함께 건넌다"
    },
    "chapter-two.doorMemory.prompt": {
      "ko": "잠긴 문에 세 개의 기억이 비친다."
    },
    "chapter-two.doorMemory.remember": {
      "ko": "리오라의 웃음소리를 떠올린다"
    },
    "chapter-two.elio_0010": {
      "ko": "계단이 웅웅거려."
    },
    "chapter-two.elio_0020": {
      "ko": "넌 먼 길을 골랐는데, 어쩌다 보니 여기로 이어졌네."
    },
    "chapter-two.elio_0030": {
      "ko": "마라, 기다려!"
    },
    "chapter-two.elio_0040": {
      "ko": "그러니까 등대가 우리 비밀 위에 서 있는 거네."
    },
    "chapter-two.elio_0050": {
      "ko": "난 이 우산 값을 기억하기 싫어."
    },
    "chapter-two.elio_0060": {
      "ko": "구멍이 아니라 개성이야."
    },
    "chapter-two.elio_0070": {
      "ko": "그럼 대답해."
    },
    "chapter-two.elio_0080": {
      "ko": "두려움도 대답이야. 길이 어디서 끝나는지 신경 쓴다는 뜻이니까."
    },
    "chapter-two.elio_0090": {
      "ko": "넌 열여섯 살이었어."
    },
    "chapter-two.elio_0100": {
      "ko": "처음부터 작별을 제대로 하는 사람은 없어."
    },
    "chapter-two.elio_0110": {
      "ko": "형이 고깃배를 타고 떠났어. 한 달 동안 주전자를 데워 뒀지."
    },
    "chapter-two.elio_0120": {
      "ko": "그럼 함께 열자."
    },
    "chapter-two.mara_0010": {
      "ko": "발소리를 전부 기억하고 있어."
    },
    "chapter-two.mara_0020": {
      "ko": "우린 높은 길을 골랐어. 이제 끝까지 가자."
    },
    "chapter-two.mara_0030": {
      "ko": "손잡고 가. 혼자 사라지는 건 없어."
    },
    "chapter-two.mara_0040": {
      "ko": "우리 언니야. 아직 여기 있어."
    },
    "chapter-two.mara_0050": {
      "ko": "이 유리는 항구 밑에서 퍼 온 모래로 만들었어."
    },
    "chapter-two.mara_0060": {
      "ko": "어느 마을이든 기억하기 싫은 것 위에 세워지지."
    },
    "chapter-two.mara_0070": {
      "ko": "구멍 났잖아."
    },
    "chapter-two.mara_0080": {
      "ko": "리오라가 렌즈 너머에서 부르고 있어."
    },
    "chapter-two.mara_0090": {
      "ko": "대답이 돌아올까 봐 무서워."
    },
    "chapter-two.mara_0100": {
      "ko": "삼 년 전에 언니를 따라갔어야 했어."
    },
    "chapter-two.mara_0110": {
      "ko": "작별 인사를 할 만큼은 컸지."
    },
    "chapter-two.mara_0120": {
      "ko": "겪어 본 사람처럼 말하네."
    },
    "chapter-two.mara_0130": {
      "ko": "파란 리본이 손잡이에 묶여 있어."
    },
    "chapter-two.mara_0140": {
      "ko": "함께."
    },
    "chapter-two.mara_0150": {
      "ko": "아직도 언니 목소리가 들려."
    },
    "chapter-two.narrator_0010": {
      "ko": "등대 문이 유리 계단 쪽으로 열린다. 그 아래, 바다가 너무 가깝다."
    },
    "chapter-two.narrator_0020": {
      "ko": "길을 고른 기억은 없다. 그 길이 뒤에 있다는 것만 안다."
    },
    "chapter-two.narrator_0030": {
      "ko": "등불 뒤에서 누군가 이쪽으로 돌아선다. 마라의 눈을 하고 있다."
    },
    "chapter-two.narrator_0040": {
      "ko": "위에서 등불이 끈기 있는 파란빛으로 맥박친다."
    },
    "chapter-two.narrator_0050": {
      "ko": "두 사람의 발소리가 울린다. 한 걸음 한 걸음이 작은 약속이다."
    },
    "chapter-two.narrator_0060": {
      "ko": "계단이 잠긴 문 쪽으로 굽어 있다."
    },
    "epilogue-dawn.elio_0010": {
      "ko": "드디어 잠들었나 보네."
    },
    "epilogue-dawn.elio_0020": {
      "ko": "자리를 내어 주는 기분일 수도 있어."
    },
    "epilogue-dawn.elio_0030": {
      "ko": "그리고 우리한테 아침밥도 남겼고."
    },
    "epilogue-dawn.elio_0040": {
      "ko": "난 도전이라고 해."
    },
    "epilogue-dawn.elio_0050": {
      "ko": "함께?"
    },
    "epilogue-dawn.mara_0010": {
      "ko": "등대가 꺼져 있어."
    },
    "epilogue-dawn.mara_0020": {
      "ko": "슬픔은 언니를 또 잃는 기분일 줄 알았어."
    },
    "epilogue-dawn.mara_0030": {
      "ko": "언니는 해안을 골랐어."
    },
    "epilogue-dawn.mara_0040": {
      "ko": "미역을 아침밥이라고 해?"
    },
    "epilogue-dawn.mara_0050": {
      "ko": "등불은 우리가 고치자."
    },
    "epilogue-dawn.mara_0060": {
      "ko": "함께."
    },
    "epilogue-dawn.narrator_0010": {
      "ko": "아침이 물때에 말끔히 씻긴 항구를 찾아온다."
    },
    "epilogue-dawn.narrator_0020": {
      "ko": "파도에도 젖지 않은 파란 리본이 부두 위에 놓여 있다."
    },
    "epilogue-dawn.narrator_0030": {
      "ko": "갈매기들이 투덜댈 때까지 둘은 웃는다."
    },
    "epilogue-dawn.narrator_0040": {
      "ko": "신호는 사라졌지만 약속은 남는다."
    },
    "epilogue-dawn.narrator_0050": {
      "ko": "새벽 엔딩."
    },
    "epilogue-dusk.elio_0010": {
      "ko": "준비되면 다시 오면 돼."
    },
    "epilogue-dusk.elio_0020": {
      "ko": "넌 지금 준비된 거야. 그건 달라."
    },
    "epilogue-dusk.elio_0030": {
      "ko": "없다면?"
    },
    "epilogue-dusk.elio_0040": {
      "ko": "내일은 우산을 두 개 챙길게."
    },
    "epilogue-dusk.mara_0010": {
      "ko": "등불은 닫았지만 이야기는 닫지 않았어."
    },
    "epilogue-dusk.mara_0020": {
      "ko": "난 삼 년 전에 준비됐었어."
    },
    "epilogue-dusk.mara_0030": {
      "ko": "리오라가 이 문 너머에 있다면, 우리가 왔다는 걸 알 거야."
    },
    "epilogue-dusk.mara_0040": {
      "ko": "그럼 그 질문을 안고 사는 법을 배우자."
    },
    "epilogue-dusk.mara_0050": {
      "ko": "내일, 다시 오자."
    },
    "epilogue-dusk.mara_0060": {
      "ko": "어떤 문은 우리를 지키려고 닫히는 거야."
    },
    "epilogue-dusk.narrator_0010": {
      "ko": "물이 빠지자 부두 아래의 문이 드러난다."
    },
    "epilogue-dusk.narrator_0020": {
      "ko": "마라가 문턱에 나침반을 내려놓는다."
    },
    "epilogue-dusk.narrator_0030": {
      "ko": "파란 리본이 못에 걸려 어둠 쪽을 가리킨다."
    },
    "epilogue-dusk.narrator_0040": {
      "ko": "바다가 끈기 있는 노크로 답한다."
    },
    "epilogue-dusk.narrator_0050": {
      "ko": "황혼 엔딩."
    },
    "final-page.narrator_0010": {
      "ko": "리오라의 마지막 장에서 소금과 등잔 기름 냄새가 난다."
    },
    "final-page.narrator_0020": {
      "ko": "마라가 오면 전해 줘. 빛은 감옥이 아니었다고. 문을 열어 두는 방법이었다고."
    },
    "final-page.narrator_0030": {
      "ko": "누군가는 잃어버린 것들이 어디로 가는지 알아야 했기에, 나는 신호를 따라갔다."
    },
    "final-page.narrator_0040": {
      "ko": "물때가 바뀌면, 함께 해안을 골라."
    }
  },
